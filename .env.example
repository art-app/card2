# ── Домен Mini App (поддомен на сервере, A-запись → IP сервера) ──
DOMAIN=trener.example.com

# ── Параметры твоего Traefik ──
# Имя внешней docker-сети, к которой подключён Traefik.
# Узнать: docker inspect <traefik-container> -f '{{json .NetworkSettings.Networks}}'
# или посмотреть в compose Traefik. Частые варианты: traefik, proxy, web.
TRAEFIK_NETWORK=proxy

# Имя HTTPS-entrypoint в Traefik (обычно websecure).
# Узнать: docker inspect <traefik> | grep entrypoints  — или в статической конфиге Traefik.
TRAEFIK_ENTRYPOINT=websecure

# Имя certresolver (Let's Encrypt) в Traefik. Варьируется: letsencrypt, le, myresolver.
# Узнать: в команде/конфиге Traefik строка --certificatesresolvers.<ИМЯ>.acme...
TRAEFIK_CERTRESOLVER=letsencrypt

# ── Токен бота от @BotFather ──
BOT_TOKEN=123456:ABC-DEF...
